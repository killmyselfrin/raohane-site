---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "ru";
}

const {
  title = "Raohane — Native desktop shell for Hyprland",
  description = "Raohane is a native Hyprland + Quickshell desktop shell focused on calm design, responsive motion, and deeply integrated desktop controls.",
  lang = "en"
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07090d" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="global-lang-switch" aria-label={lang === "ru" ? "Язык сайта" : "Site language"}>
      <a class="global-showcase" href={lang === "ru" ? `${base}ru/showcase/` : `${base}showcase/`}>{lang === "ru" ? "Галерея" : "Showcase"}</a>
      <span class="global-divider"></span>
      <a class:list={[lang === "en" && "is-active"]} href={base}>EN</a>
      <a class:list={[lang === "ru" && "is-active"]} href={`${base}ru/`}>RU</a>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  .global-lang-switch {
    position: absolute;
    top: 26px;
    right: max(138px, calc((100vw - var(--width)) / 2 + 118px));
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(11,13,19,.72);
    backdrop-filter: blur(16px);
  }
  .global-lang-switch a {
    min-width: 30px;
    padding: 6px 7px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    text-align: center;
  }
  .global-lang-switch a:hover { color: var(--text); }
  .global-lang-switch a.is-active {
    color: var(--text);
    background: rgba(184,165,255,.12);
  }
  .global-lang-switch .global-showcase { padding-inline: 9px; color: var(--text-soft); }
  .global-divider { width: 1px; height: 16px; margin: 0 3px; background: var(--line); }
  body:has(.site-header-shared) > .global-lang-switch { display: none; }
  @media (max-width: 820px) {
    .global-lang-switch { right: 20px; top: 22px; }
    .global-lang-switch .global-showcase, .global-divider { display: none; }
  }
</style>
