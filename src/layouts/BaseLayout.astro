---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "ru";
}

const {
  title = "Raohane — Native desktop shell for Hyprland",
  description = "Raohane is a native Hyprland + Quickshell desktop shell focused on calm design, responsive motion, and deeply integrated desktop controls.",
  lang = "en"
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL(Astro.url.origin);
const relativePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : "";
const routePath = relativePath.replace(/^ru\/?/, "");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const englishUrl = new URL(`${base}${routePath}`, site).toString();
const russianUrl = new URL(`${base}ru/${routePath}`, site).toString();
const socialImage = new URL(`${base}screenshots/desktop.webp`, site).toString();
const repositoryUrl = "https://github.com/killmyselfrin/raohane-dots";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Raohane",
      url: new URL(base, site).toString(),
      description,
      inLanguage: ["en", "ru"]
    },
    {
      "@type": "SoftwareApplication",
      name: "Raohane",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Linux",
      softwareVersion: "0.10.0-dev",
      description: "A native desktop shell for Hyprland built with Quickshell.",
      url: new URL(base, site).toString(),
      codeRepository: repositoryUrl,
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      isAccessibleForFree: true
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07090d" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="ru" href={russianUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:site_name" content="Raohane" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1917" />
    <meta property="og:image:height" content="1079" />
    <meta property="og:image:alt" content="Raohane desktop shell running on Hyprland" />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "ru" ? "en_US" : "ru_RU"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="global-lang-switch" aria-label={lang === "ru" ? "Язык сайта" : "Site language"}>
      <a class="global-showcase" href={lang === "ru" ? `${base}ru/showcase/` : `${base}showcase/`}>{lang === "ru" ? "Галерея" : "Showcase"}</a>
      <span class="global-divider"></span>
      <a class:list={[lang === "en" && "is-active"]} href={englishUrl}>EN</a>
      <a class:list={[lang === "ru" && "is-active"]} href={russianUrl}>RU</a>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  .global-lang-switch {
    position: absolute;
    top: 26px;
    right: max(138px, calc((100vw - var(--width)) / 2 + 118px));
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(11,13,19,.72);
    backdrop-filter: blur(16px);
  }
  .global-lang-switch a {
    min-width: 30px;
    padding: 6px 7px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    text-align: center;
  }
  .global-lang-switch a:hover { color: var(--text); }
  .global-lang-switch a.is-active {
    color: var(--text);
    background: rgba(184,165,255,.12);
  }
  .global-lang-switch .global-showcase { padding-inline: 9px; color: var(--text-soft); }
  .global-divider { width: 1px; height: 16px; margin: 0 3px; background: var(--line); }
  body:has(.site-header-shared) > .global-lang-switch { display: none; }
  @media (max-width: 820px) {
    .global-lang-switch { right: 20px; top: 22px; }
    .global-lang-switch .global-showcase, .global-divider { display: none; }
  }
</style>
