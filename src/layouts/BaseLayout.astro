---
import "../styles/global.css";
import "../styles/redesign.css";
import "../styles/editorial-pages.css";
import ScreenshotViewer from "../components/ScreenshotViewer.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "ru";
  noindex?: boolean;
}

const {
  title = "Raohane 1.2.1 — Context-aware desktop shell for Hyprland",
  description = "Raohane 1.2.1 is the stable contextual-shell release for Hyprland + Quickshell, with Scenes, application-aware switching, native shell actions and improved lyrics flow.",
  lang = "en",
  noindex = false
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL(Astro.url.origin);
const relativePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : "";
const routePath = relativePath.replace(/^ru(?:\/|$)/, "");
const canonicalPath = `${base}${lang === "ru" ? "ru/" : ""}${routePath.replace(/\/$/, "")}${routePath ? "/" : ""}`;
const canonicalUrl = new URL(canonicalPath, site).toString();
const englishUrl = new URL(`${base}${routePath}`, site).toString();
const russianUrl = new URL(`${base}ru/${routePath}`, site).toString();
const socialImage = new URL(`${base}screenshots/desktop.webp`, site).toString();
const repositoryUrl = "https://github.com/killmyselfrin/raohane-dots";
const changelogUrl = `${repositoryUrl}/blob/main/CHANGELOG.md`;
const stableVersion = "1.2.1";
const releaseDate = "2026-09-08";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Raohane",
      url: new URL(base, site).toString(),
      description,
      inLanguage: ["en", "ru"],
      dateModified: releaseDate
    },
    {
      "@type": ["SoftwareApplication", "SoftwareSourceCode"],
      name: "Raohane",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Linux",
      description: "A context-aware desktop shell for Hyprland built with Quickshell.",
      url: new URL(base, site).toString(),
      codeRepository: repositoryUrl,
      license: "https://www.gnu.org/licenses/gpl-3.0.html",
      isAccessibleForFree: true,
      softwareVersion: stableVersion,
      datePublished: releaseDate,
      dateModified: releaseDate,
      releaseNotes: changelogUrl,
      screenshot: socialImage
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#09090a" />
    <meta name="description" content={description} />
    <meta name="application-name" content="Raohane" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    {import.meta.env.GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.GOOGLE_SITE_VERIFICATION} />}
    {import.meta.env.BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.BING_SITE_VERIFICATION} />}
    {import.meta.env.YANDEX_SITE_VERIFICATION && <meta name="yandex-verification" content={import.meta.env.YANDEX_SITE_VERIFICATION} />}
    {!noindex && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {!noindex && <link rel="alternate" hreflang="ru" href={russianUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <meta property="og:site_name" content="Raohane" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Raohane desktop shell running on Hyprland" />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "ru" ? "en_US" : "ru_RU"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "ru" ? "Перейти к содержимому" : "Skip to content"}</a>
    <slot />
    <ScreenshotViewer lang={lang} />
  </body>
</html>
