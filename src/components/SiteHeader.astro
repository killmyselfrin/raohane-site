---
interface Props {
  active?: "home" | "features" | "showcase" | "install" | "dependencies" | "docs" | "changelog";
  lang?: "en" | "ru";
}

const { active = "home", lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "ru" ? `${base}ru/` : base;
const route = active === "home" ? "" : `${active}/`;
const labels = lang === "ru"
  ? {
      features: "Возможности",
      showcase: "Галерея",
      install: "Установка",
      dependencies: "Пакеты",
      docs: "Документация",
      changelog: "Изменения",
      get: "Установить"
    }
  : {
      features: "Features",
      showcase: "Showcase",
      install: "Install",
      dependencies: "Packages",
      docs: "Docs",
      changelog: "Changelog",
      get: "Get Raohane"
    };
const links = ["features", "showcase", "install", "dependencies", "docs", "changelog"] as const;
---

<header class="site-header shell-width site-header-shared">
  <a class="brand" href={prefix} aria-label="Raohane home">
    <span class="brand-mark">R</span>
    <span>RAOHANE</span>
  </a>
  <nav class="nav-links" aria-label={lang === "ru" ? "Основная навигация" : "Main navigation"}>
    {links.map((key) => (
      <a class={active === key ? "is-active" : ""} aria-current={active === key ? "page" : undefined} href={`${prefix}${key}/`}>{labels[key]}</a>
    ))}
    <a href="https://github.com/killmyselfrin/raohane-dots" target="_blank" rel="noreferrer">GitHub ↗</a>
  </nav>
  <div class="header-actions">
    <div class="lang-switch" aria-label={lang === "ru" ? "Язык сайта" : "Site language"}>
      <a class:list={[lang === "en" && "is-active"]} href={`${base}${route}`}>EN</a>
      <a class:list={[lang === "ru" && "is-active"]} href={`${base}ru/${route}`}>RU</a>
    </div>
    <a class="header-cta" href={`${prefix}install/`}>{labels.get}</a>
    <details class="mobile-menu">
      <summary>{lang === "ru" ? "Меню" : "Menu"}</summary>
      <nav aria-label={lang === "ru" ? "Мобильная навигация" : "Mobile navigation"}>
        {links.map((key) => <a href={`${prefix}${key}/`} aria-current={active === key ? "page" : undefined}>{labels[key]}</a>)}
        <a href="https://github.com/killmyselfrin/raohane-dots">GitHub ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header-shared { grid-template-columns: auto 1fr auto; gap: 24px; }
  .site-header-shared .nav-links { justify-content: center; gap: 18px; font-size: 14px; }
  .mobile-menu { display: none; }
  .mobile-menu summary { cursor: pointer; padding: 10px; border: 1px solid var(--line); border-radius: 10px; font-size: 14px; }
  .mobile-menu nav { position: absolute; top: 72px; right: 0; width: min(300px, calc(100vw - 40px)); display: grid; padding: 12px; border: 1px solid var(--line-strong); border-radius: 16px; background: #10131c; box-shadow: var(--shadow); }
  .mobile-menu nav a { padding: 12px; border-radius: 8px; font-size: 16px; }
  .mobile-menu nav a:hover, .mobile-menu nav a[aria-current] { background: var(--accent-soft); }
  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255,255,255,.025);
  }

  .lang-switch a {
    min-width: 30px;
    padding: 6px 7px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    transition: color 150ms ease, background 150ms ease;
  }

  .lang-switch a:hover { color: var(--text); }
  .lang-switch a.is-active {
    color: var(--text);
    background: rgba(184,165,255,.12);
  }

  @media (max-width: 1040px) {
    .site-header-shared .nav-links { gap: 16px; }
    .site-header-shared .header-cta { display: none; }
  }

  @media (max-width: 1100px) {
    .site-header-shared { grid-template-columns: 1fr auto; }
    .site-header-shared .nav-links { display: none; }
    .mobile-menu { display: block; }
    .site-header-shared .header-cta { display: none; }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
