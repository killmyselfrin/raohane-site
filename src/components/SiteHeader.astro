---
interface Props {
  active?: "home" | "features" | "install" | "dependencies" | "docs" | "changelog";
}

const { active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  ["features", "Features"],
  ["install", "Install"],
  ["dependencies", "Packages"],
  ["docs", "Docs"],
  ["changelog", "Changelog"]
] as const;
---

<header class="site-header shell-width site-header-shared">
  <a class="brand" href={base} aria-label="Raohane home">
    <span class="brand-mark">R</span>
    <span>RAOHANE</span>
  </a>
  <nav class="nav-links" aria-label="Main navigation">
    {links.map(([key, label]) => (
      <a class={active === key ? "is-active" : ""} href={`${base}${key}/`}>{label}</a>
    ))}
    <a href="https://github.com/killmyselfrin/raohane-dots" target="_blank" rel="noreferrer">GitHub ↗</a>
  </nav>
  <a class="header-cta" href={`${base}install/`}>Get Raohane</a>
</header>
