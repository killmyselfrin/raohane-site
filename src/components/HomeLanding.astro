---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import ShellPreview from "./ShellPreview.astro";

interface Props { lang?: "en" | "ru" }
const { lang = "en" } = Astro.props;
const ru = lang === "ru";
const base = import.meta.env.BASE_URL;
const prefix = ru ? base + "ru/" : base;
const github = "https://github.com/killmyselfrin/raohane-dots";
const installCommand = "git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\nbash install.sh";

const t = ru ? {
  title: "Raohane — Рабочий стол с характером",
  description: "Raohane — атмосферная оболочка Hyprland и Quickshell: адаптивные цвета, Wallpaper Studio, Widget Studio, Context Island и нативные инструменты.",
  top: "НАТИВНАЯ ОБОЛОЧКА / HYPRLAND",
  source: "ИСТОЧНИК НА GITHUB",
  above: "СОЗДАНО ДЛЯ ТВОЕГО ПРОСТРАНСТВА",
  hero1: "Рабочий стол.",
