---
interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "ru" ? `${base}ru/` : base;
const labels = lang === "ru"
  ? {
      tagline: "Нативная оболочка рабочего стола для Hyprland.",
      features: "Возможности",
      showcase: "Галерея",
      install: "Установка",
      dependencies: "Пакеты",
      docs: "Документация",
      changelog: "Изменения"
    }
  : {
      tagline: "Native desktop shell for Hyprland.",
      features: "Features",
      showcase: "Showcase",
      install: "Install",
      dependencies: "Packages",
      docs: "Docs",
      changelog: "Changelog"
    };
---

<footer class="site-footer shell-width">
  <a class="brand" href={prefix}><span class="brand-mark">R</span><span>RAOHANE</span></a>
  <p>{labels.tagline}</p>
  <div>
    <a href={`${prefix}features/`}>{labels.features}</a>
    <a href={`${prefix}showcase/`}>{labels.showcase}</a>
    <a href={`${prefix}install/`}>{labels.install}</a>
    <a href={`${prefix}dependencies/`}>{labels.dependencies}</a>
    <a href={`${prefix}docs/`}>{labels.docs}</a>
    <a href={`${prefix}changelog/`}>{labels.changelog}</a>
    <a href="https://github.com/killmyselfrin/raohane-dots">GitHub</a>
  </div>
</footer>
