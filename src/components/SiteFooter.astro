---
interface Props {
  lang?: "en" | "ru";
}

const { lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = lang === "ru" ? `${base}ru/` : base;
const labels = lang === "ru"
  ? {
      tagline: "Контекстная оболочка Hyprland, которая остаётся спокойной до момента, когда действительно нужна.",
      features: "Возможности",
      showcase: "Галерея",
      install: "Установка",
      dependencies: "Пакеты",
      docs: "Документация",
      changelog: "Изменения",
      status: "1.2.1 STABLE",
      source: "Открытый код"
    }
  : {
      tagline: "A context-aware Hyprland shell that stays quiet until the desktop has something useful to say.",
      features: "Features",
      showcase: "Showcase",
      install: "Install",
      dependencies: "Packages",
      docs: "Docs",
      changelog: "Changelog",
      status: "1.2.1 STABLE",
      source: "Open source"
    };
---

<footer class="footer-v3">
  <div class="shell-width footer-grid-v3">
    <div class="footer-identity">
      <a class="footer-brand" href={prefix} aria-label="Raohane home">
        <span>R</span><b>RAOHANE</b>
      </a>
      <p>{labels.tagline}</p>
    </div>

    <div class="footer-nav-v3">
      <span>INDEX</span>
      <a href={`${prefix}features/`}>{labels.features}</a>
      <a href={`${prefix}showcase/`}>{labels.showcase}</a>
      <a href={`${prefix}install/`}>{labels.install}</a>
      <a href={`${prefix}dependencies/`}>{labels.dependencies}</a>
      <a href={`${prefix}docs/`}>{labels.docs}</a>
      <a href={`${prefix}changelog/`}>{labels.changelog}</a>
    </div>

    <div class="footer-meta-v3">
      <span>RELEASE</span>
      <b>{labels.status}</b>
      <small>Hyprland · Quickshell</small>
      <a href="https://github.com/killmyselfrin/raohane-dots" target="_blank" rel="noreferrer">{labels.source} ↗</a>
    </div>
  </div>

  <div class="shell-width footer-line-v3">
    <span>RAOHANE / 羅羽音</span>
    <span>GPL-3.0 · 2026</span>
  </div>
</footer>

<style>
  .footer-v3 {
    margin-top: 30px;
    padding: 64px 0 24px;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(255,255,255,.012));
  }
  .footer-grid-v3 {
    display: grid;
    grid-template-columns: minmax(280px,1.2fr) minmax(180px,.55fr) minmax(180px,.55fr);
    gap: clamp(42px,8vw,120px);
    padding-bottom: 60px;
  }
  .footer-brand { display: inline-flex; align-items: center; gap: 11px; }
  .footer-brand span {
    width: 35px; height: 35px; display: grid; place-items: center;
    border: 1px solid rgba(223,195,207,.23); border-radius: 10px;
    background: rgba(223,195,207,.07); color: var(--text); font: 700 12px Manrope,sans-serif;
  }
  .footer-brand b { color: var(--text); font: 700 12px Manrope,sans-serif; letter-spacing: .18em; }
  .footer-identity p { max-width: 410px; margin: 24px 0 0; color: var(--muted); font-size: 12px; line-height: 1.75; }
  .footer-nav-v3, .footer-meta-v3 { display: grid; align-content: start; gap: 9px; }
  .footer-nav-v3 > span, .footer-meta-v3 > span { margin-bottom: 6px; color: var(--accent); font-size: 8px; font-weight: 700; letter-spacing: .17em; }
  .footer-nav-v3 a, .footer-meta-v3 a { width: fit-content; color: var(--muted); font-size: 11px; transition: color 140ms ease; }
  .footer-nav-v3 a:hover, .footer-meta-v3 a:hover { color: var(--text); }
  .footer-meta-v3 b { color: var(--text); font-size: 12px; }
  .footer-meta-v3 small { margin-bottom: 12px; color: var(--muted); font-size: 9px; }
  .footer-line-v3 {
    min-height: 52px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: rgba(203,197,189,.45);
    font-size: 8px;
    letter-spacing: .12em;
  }
  @media(max-width:760px){
    .footer-grid-v3{grid-template-columns:1fr 1fr;gap:42px 28px}.footer-identity{grid-column:1/-1}.footer-v3{padding-top:48px}
  }
  @media(max-width:480px){.footer-grid-v3{grid-template-columns:1fr}.footer-identity{grid-column:auto}.footer-line-v3{align-items:center}}
</style>
