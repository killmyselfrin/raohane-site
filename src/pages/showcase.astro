---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/content.css";

const base = import.meta.env.BASE_URL;
const shots = [
  {
    image: `${base}screenshots/desktop.webp`,
    eyebrow: "Desktop",
    title: "The calm baseline.",
    description: "A live Raohane desktop with resident workspaces, Context Island, system status and the left command surface sitting over the wallpaper instead of fighting it.",
    tags: ["Bar", "Context Island", "Sidebar", "Workspaces"]
  },
  {
    image: `${base}screenshots/control-center.webp`,
    eyebrow: "Control Center",
    title: "System control without leaving the flow.",
    description: "Network, Bluetooth, audio, brightness, notifications, media and session actions live in one native surface. Microphone/device controls stay consolidated instead of being repeated across sidebars.",
    tags: ["Quick Controls", "Audio", "Notifications", "Media"]
  },
  {
    image: `${base}screenshots/launcher.webp`,
    eyebrow: "Launcher",
    title: "Apps and actions in one call.",
    description: "Applications and Raohane actions share one searchable surface, providing the base for the contextual Launcher behavior introduced in the 1.2 release.",
    tags: ["Apps", "Actions", "Quick access", "Search"]
  },
  {
    image: `${base}screenshots/settings.webp`,
    eyebrow: "Settings",
    title: "The shell, shaped live.",
    description: "Themes, widgets, Bar & Dock, displays, graphics, Hyprland preferences, Scenes and integrations belong to one settings workspace.",
    tags: ["Themes", "Scenes", "Hyprland", "Widgets"]
  }
];
---

<BaseLayout title="Showcase — Raohane" description="Full HD screenshots of Raohane running in a real Hyprland + Quickshell desktop session.">
  <div class="page-shell">
    <SiteHeader active="showcase" />
    <main id="main-content" class="shell-width showcase-editorial">
      <section class="page-intro">
        <span class="page-badge">4 real captures · 1920 × 1080</span>
        <h1>Real session.<br/><em>No concept renders.</em></h1>
        <p>These are Full HD captures from an actual Raohane Hyprland session. Open any frame for the original image; smaller 800 × 450 variants are served automatically where appropriate.</p>
      </section>

      <section class="showcase-gallery-v3" aria-label="Raohane screenshots">
        {shots.map((shot, index) => (
          <article class="showcase-piece">
            <div class="showcase-image">
              <a data-gallery href={shot.image} target="_blank" rel="noreferrer" aria-label={`Open Full HD ${shot.eyebrow} screenshot`}>
                <img width="1920" height="1080" srcset={`${shot.image.replace(".webp", "-800.webp")} 800w, ${shot.image} 1920w`} sizes="(max-width: 880px) calc(100vw - 38px), 820px" src={shot.image} alt={`Raohane ${shot.eyebrow} screenshot`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                <small>FULL HD · OPEN ↗</small>
              </a>
            </div>
            <div class="showcase-copy">
              <span>0{index + 1} · {shot.eyebrow.toUpperCase()}</span>
              <h2>{shot.title}</h2>
              <p>{shot.description}</p>
              <div class="shot-tags">
                {shot.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
