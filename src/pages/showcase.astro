---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/content.css";

const base = import.meta.env.BASE_URL;
const shots = [
  {
    image: `${base}screenshots/desktop.webp`,
    eyebrow: "Desktop",
    title: "The calm baseline.",
    description: "A live Raohane desktop with resident workspaces, Context Island, system status and the left command surface sitting over the wallpaper instead of fighting it.",
    tags: ["Bar", "Context Island", "Sidebar", "Workspaces"]
  },
  {
    image: `${base}screenshots/control-center.webp`,
    eyebrow: "Control Center",
    title: "System control without leaving the flow.",
    description: "Network, Bluetooth, audio, microphone, brightness, notifications, media and session actions live in one translucent native surface.",
    tags: ["Quick Controls", "Audio", "Notifications", "Media"]
  },
  {
    image: `${base}screenshots/launcher.webp`,
    eyebrow: "Launcher",
    title: "Apps and actions in one call.",
    description: "The launcher combines applications with Raohane actions and quick access so common shell tasks stay one search away.",
    tags: ["Apps", "Actions", "Quick access", "Search"]
  },
  {
    image: `${base}screenshots/settings.webp`,
    eyebrow: "Settings",
    title: "The shell, shaped live.",
    description: "Themes, widgets, bar and dock, display, graphics drivers, Hyprland preferences and integrations share one settings workspace.",
    tags: ["Themes", "Graphics & Drivers", "Hyprland", "Widgets"]
  }
];
---

<BaseLayout title="Showcase — Raohane" description="Real screenshots of Raohane running as a Hyprland + Quickshell desktop shell.">
  <div class="page-shell">
    <SiteHeader active="showcase" />
    <main id="main-content" class="content-main shell-width showcase-main">
      <section class="page-intro showcase-intro">
        <span class="page-badge">Captured from a live session</span>
        <h1>Real desktop.<br/><em>Real Raohane.</em></h1>
        <p>Explore the desktop, system controls, launcher and settings captured in a live Hyprland session. Open any image to view or download it in Full HD.</p>
      </section>

      <section class="showcase-list" aria-label="Raohane screenshots">
        {shots.map((shot, index) => (
          <article class:list={["showcase-shot", index % 2 === 1 && "is-reverse"]}>
            <a class="shot-frame" data-gallery href={shot.image} target="_blank" rel="noreferrer" aria-label={`Open full ${shot.eyebrow} screenshot`}>
              <img width="1920" height="1080" srcset={`${shot.image.replace(".webp", "-800.webp")} 800w, ${shot.image} 1920w`} sizes="(max-width: 850px) calc(100vw - 40px), 800px" src={shot.image} alt={`Raohane ${shot.eyebrow} screenshot`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <span class="shot-open">Full HD · 1920 × 1080 ↗</span>
            </a>
            <div class="shot-copy">
              <span class="section-kicker">0{index + 1} · {shot.eyebrow}</span>
              <h2>{shot.title}</h2>
              <p>{shot.description}</p>
              <div class="shot-tags">
                {shot.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .showcase-main { padding-bottom: 70px; }
  .showcase-intro { padding-bottom: 72px; }
  .showcase-list { display: grid; gap: 94px; }
  .showcase-shot {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, .65fr);
    gap: 48px;
    align-items: center;
  }
  .showcase-shot.is-reverse .shot-frame { order: 2; }
  .showcase-shot.is-reverse .shot-copy { order: 1; }
  .shot-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 22px;
    background: #0b0d12;
    box-shadow: 0 28px 70px rgba(0,0,0,.34);
  }
  .shot-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05);
  }
  .shot-frame img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 360ms cubic-bezier(.2,.8,.2,1), filter 220ms ease;
  }
  .shot-frame:hover img { transform: scale(1.012); filter: brightness(1.04); }
  .shot-open {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 8px 10px;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 9px;
    background: rgba(8,10,15,.74);
    backdrop-filter: blur(14px);
    color: #d8d4df;
    font-size: 12px;
    font-weight: 600;
  }
  .shot-copy h2 {
    margin: 14px 0 14px;
    font-family: Manrope, Inter, sans-serif;
    font-size: clamp(28px, 3.2vw, 45px);
    line-height: 1.04;
    letter-spacing: -.045em;
  }
  .shot-copy p { color: var(--text-soft); line-height: 1.75; font-size: 14px; }
  .shot-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 22px; }
  .shot-tags span {
    padding: 7px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255,255,255,.025);
    font-size: 12px;
  }
  @media (max-width: 850px) {
    .showcase-list { gap: 58px; }
    .showcase-shot { grid-template-columns: 1fr; gap: 24px; }
    .showcase-shot.is-reverse .shot-frame,
    .showcase-shot.is-reverse .shot-copy { order: initial; }
  }
</style>
