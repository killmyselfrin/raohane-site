---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShellPreview from "../components/ShellPreview.astro";

const github = "https://github.com/killmyselfrin/raohane-dots";
const base = import.meta.env.BASE_URL;
const installCommand = "git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\n./install-raohane.sh";
---

<BaseLayout title="Raohane 1.2.1 — Context-aware desktop shell for Hyprland" description="Raohane 1.2.1 is the stable contextual-shell release for Hyprland + Quickshell, with Scenes, application-aware switching, native shell actions and improved lyrics flow.">
  <div class="page-shell home-v3">
    <SiteHeader active="home" />

    <main id="main-content">
      <section class="home-hero shell-width">
        <div class="hero-grid-v3 reveal">
          <div class="hero-copy-v3">
            <div class="eyebrow"><span></span> HYPRLAND · QUICKSHELL · 1.2.1 STABLE</div>
            <h1>A desktop that<br/><em>adapts to context.</em></h1>
            <p class="hero-lede">
              Raohane is a native Hyprland shell built around context instead of clutter. Scenes reshape runtime behavior, Launcher actions follow what you are doing, and the interface stays quiet until it has something useful to say.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href={`${base}install/`}>Install Raohane <span>→</span></a>
              <a class="button button-ghost" href={github} target="_blank" rel="noreferrer">Source on GitHub ↗</a>
            </div>
          </div>

          <aside class="hero-manifesto" aria-label="Raohane design principles">
            <p>One shell, one state model, one visual language — from the bar and launcher to recording, media, notifications and system controls.</p>
            <div class="manifesto-list">
              <div class="manifesto-row"><span>01</span><b>Native state</b><small>QML</small></div>
              <div class="manifesto-row"><span>02</span><b>Context-aware</b><small>Scenes</small></div>
              <div class="manifesto-row"><span>03</span><b>Reversible</b><small>Runtime</small></div>
              <div class="manifesto-row"><span>04</span><b>Quiet motion</b><small>Motion</small></div>
            </div>
          </aside>
        </div>

        <ShellPreview />

        <div class="hero-release-rail reveal" aria-label="Raohane release facts">
          <div><b>1.2.1 stable</b><span>Contextual shell + lyrics flow hotfix</span></div>
          <div><b>Hyprland + Quickshell</b><span>Native Linux desktop runtime</span></div>
          <div><b>Arch first</b><span>CachyOS · Arch · EndeavourOS</span></div>
          <div><b>GPL-3.0</b><span>Open source and inspectable</span></div>
        </div>
      </section>

      <section class="home-section shell-width reveal" id="features">
        <span class="section-kicker">01 · CONTEXTUAL SHELL</span>
        <div class="editorial-heading">
          <h2>Change the desktop<br/><em>without changing yourself.</em></h2>
          <p>Scenes apply temporary runtime policy instead of overwriting your base configuration. Gaming can suppress distractions; Focus can quiet notifications; Work can keep the session awake — and Balanced restores your baseline.</p>
        </div>

        <div class="scene-stage">
          <article class="scene-intro">
            <span class="scene-current">ACTIVE CONTEXT · BALANCED</span>
            <h3>Context is a layer,<br/>not a new config.</h3>
            <p>Application-aware switching can activate a Scene from the focused app and return to the user-selected Scene when that context ends.</p>
          </article>

          <div class="scene-list">
            <article class="scene-card"><div class="scene-card-head"><span>01 · BASELINE</span><i></i></div><h3>Balanced</h3><p>Your normal desktop. Raohane restores the runtime state that existed before temporary Scene policy was applied.</p></article>
            <article class="scene-card"><div class="scene-card-head"><span>02 · PLAY</span><i></i></div><h3>Gaming</h3><p>Contextual quick actions, DND, Keep Awake and Game Mode can follow the game without rewriting persistent settings.</p></article>
            <article class="scene-card"><div class="scene-card-head"><span>03 · QUIET</span><i></i></div><h3>Focus</h3><p>Reduce interruptions and keep important shell feedback available without turning the desktop into a separate profile.</p></article>
            <article class="scene-card"><div class="scene-card-head"><span>04 · WORK</span><i></i></div><h3>Work</h3><p>Keep the session ready for longer tasks while preserving the same shell, theme and underlying configuration.</p></article>
          </div>
        </div>
      </section>

      <section class="home-section shell-width reveal">
        <span class="section-kicker">02 · ONE SYSTEM</span>
        <div class="editorial-heading">
          <h2>Surfaces share state.<br/><em>Not just styling.</em></h2>
          <p>Raohane is designed as a desktop system rather than a directory of unrelated widgets. Services are shared, runtime actions stay native, and the same context can appear in the Launcher, Control Center and Context Island.</p>
        </div>

        <div class="system-rows">
          <article class="system-row"><span>01</span><h3>Launcher 2.0</h3><p>Applications, Scene commands and live actions such as microphone, audio output, recording, DND and media in one command surface.</p><small>SUPER + R</small></article>
          <article class="system-row"><span>02</span><h3>Context Island</h3><p>Prioritized activity for recording, privacy, media, Scene transitions and the active application without permanent visual noise.</p><small>LIVE STATE</small></article>
          <article class="system-row"><span>03</span><h3>Control Center</h3><p>Network, Bluetooth, PipeWire, brightness, notifications and Scene switching behind native shared services.</p><small>SYSTEM</small></article>
          <article class="system-row"><span>04</span><h3>Media + lyrics</h3><p>MPRIS playback, synced or plain LRCLIB lyrics and a fullscreen-friendly overlay with click-to-seek behavior.</p><small>MPRIS</small></article>
          <article class="system-row"><span>05</span><h3>Capture tools</h3><p>Screenshot, gameplay recording, OCR and screen translation live inside the same Raohane interaction model.</p><small>TOOLS</small></article>
        </div>
      </section>

      <section class="home-section shell-width reveal" id="install">
        <div class="install-v3">
          <div>
            <span class="section-kicker">03 · INSTALL</span>
            <h2>Three commands.<br/><em>One shell.</em></h2>
            <p>Raohane 1.2.1 targets modern Arch-based Hyprland systems. The guided installer checks dependencies, stages the native runtime and configures the user service without hiding the underlying files from you.</p>
            <div class="distro-pills" role="group" aria-label="Supported distributions">
              <span>CachyOS</span><span>Arch Linux</span><span>EndeavourOS</span>
            </div>
            <a class="text-link" href={`${base}install/`}>Open the complete install guide →</a>
          </div>

          <div class="terminal-card">
            <div class="terminal-top"><div><i></i><i></i><i></i></div><span>raohane — install</span><button class="copy-button" data-copy-install>Copy</button></div>
            <pre><code>{installCommand}</code></pre>
            <div class="terminal-status"><span>●</span> guided installer · dependencies checked before install</div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-install]');
    copyButton?.addEventListener('click', async () => {
      const command = `git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\n./install-raohane.sh`;
      try {
        await navigator.clipboard.writeText(command);
        copyButton.textContent = 'Copied';
        window.setTimeout(() => copyButton.textContent = 'Copy', 1400);
      } catch {
        copyButton.textContent = 'Select text';
      }
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('revealed'));
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach((item) => observer.observe(item));
    } else {
      document.querySelectorAll('.reveal').forEach((item) => item.classList.add('revealed'));
    }
  </script>
</BaseLayout>
