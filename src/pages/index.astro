---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ShellPreview from "../components/ShellPreview.astro";

const github = "https://github.com/killmyselfrin/raohane-dots";
const base = import.meta.env.BASE_URL;
const installCommand = "git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\n./install-raohane.sh";

const petals = [
  { x: 4,  size: 0.82, opacity: 0.38, duration: 15.8, delay: -2.6, driftMid: 34,  driftEnd: -18, rot: 18 },
  { x: 13, size: 1.08, opacity: 0.58, duration: 18.4, delay: -11.1, driftMid: -28, driftEnd: 22,  rot: 61 },
  { x: 22, size: 0.9,  opacity: 0.46, duration: 16.9, delay: -6.7, driftMid: 42,  driftEnd: 10,  rot: 104 },
  { x: 31, size: 1.2,  opacity: 0.62, duration: 20.2, delay: -15.4, driftMid: -36, driftEnd: 30,  rot: 147 },
  { x: 41, size: 0.76, opacity: 0.32, duration: 14.7, delay: -4.1, driftMid: 25,  driftEnd: -25, rot: 203 },
  { x: 49, size: 1.0,  opacity: 0.54, duration: 19.1, delay: -12.8, driftMid: -44, driftEnd: -8,  rot: 252 },
  { x: 58, size: 0.86, opacity: 0.42, duration: 17.3, delay: -8.9, driftMid: 31,  driftEnd: 26,  rot: 299 },
  { x: 66, size: 1.14, opacity: 0.6,  duration: 21.0, delay: -17.2, driftMid: -30, driftEnd: 18,  rot: 338 },
  { x: 74, size: 0.72, opacity: 0.3,  duration: 15.3, delay: -5.4, driftMid: 39,  driftEnd: -14, rot: 23 },
  { x: 82, size: 1.05, opacity: 0.5,  duration: 18.8, delay: -13.7, driftMid: -38, driftEnd: -28, rot: 79 },
  { x: 89, size: 0.92, opacity: 0.44, duration: 16.4, delay: -9.8, driftMid: 28,  driftEnd: 20,  rot: 132 },
  { x: 95, size: 1.18, opacity: 0.56, duration: 20.6, delay: -18.5, driftMid: -25, driftEnd: 34,  rot: 186 },
];
---

<BaseLayout title="Raohane 1.0.0 — Native desktop shell for Hyprland" description="Raohane 1.0.0 is the first stable native Hyprland + Quickshell desktop shell release, with cohesive system controls, themes, motion and desktop tools.">
  <div class="page-shell">
    <SiteHeader active="home" />

    <main id="main-content">
      <section class="hero shell-width">
        <div class="hero-glow hero-glow-a"></div>
        <div class="hero-glow hero-glow-b"></div>

        <div class="sakura-field" aria-hidden="true">
          {petals.map((petal) => (
            <i style={`--petal-x:${petal.x}%;--petal-scale:${petal.size};--petal-opacity:${petal.opacity};--petal-duration:${petal.duration}s;--petal-delay:${petal.delay}s;--petal-drift-mid:${petal.driftMid}px;--petal-drift-end:${petal.driftEnd}px;--petal-rotation:${petal.rot}deg`}></i>
          ))}
        </div>

        <div class="hero-copy reveal">
          <div class="eyebrow"><span></span> HYPRLAND · QUICKSHELL · 1.0.0 STABLE</div>
          <h1>Desktop,<br/><em>composed.</em></h1>
          <p class="hero-lede">
            Raohane is a calm, responsive desktop shell built around Hyprland.
            Native controls, deliberate motion and a visual language that stays out of your way.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${base}install/`}>Install Raohane <span>→</span></a>
            <a class="button button-ghost" href={github} target="_blank" rel="noreferrer">View source</a>
          </div>
          <div class="hero-meta">
            <span><b>1.0.0</b> stable</span>
            <span><b>Hyprland</b> + Quickshell</span>
            <span><b>Arch</b> first</span>
            <span><b>GPL-3.0</b> open source</span>
          </div>
        </div>

        <ShellPreview />
      </section>

      <section class="section shell-width reveal" id="features">
        <div class="section-kicker">01 · BUILT AS A SHELL</div>
        <div class="section-heading">
          <h2>Everything you touch<br/>belongs to <em>Raohane.</em></h2>
          <p>Not a collection of disconnected widgets. One native desktop layer with shared state, motion, themes and system services.</p>
        </div>
        <div class="feature-grid">
          <article class="feature feature-wide">
            <span class="feature-index">01</span><div class="feature-icon">⌘</div>
            <h3>Resident. Immediate.</h3><p>Primary surfaces stay warm and respond before background refresh work begins. The interface comes first.</p>
            <div class="latency-strip"><span></span><span></span><span></span><span></span><b>&lt; 50 ms target</b></div>
          </article>
          <article class="feature"><span class="feature-index">02</span><div class="feature-icon">桜</div><h3>Sakura ambience</h3><p>A restrained Japanese accent, designed as part of the shell instead of a heavy particle effect.</p></article>
          <article class="feature"><span class="feature-index">03</span><div class="feature-icon">◌</div><h3>Native controls</h3><p>PipeWire, NetworkManager, BlueZ, Hyprland and system services behind one cohesive control surface.</p></article>
          <article class="feature"><span class="feature-index">04</span><div class="feature-icon">Ⅱ</div><h3>Media, everywhere</h3><p>MPRIS controls, lyrics and an overlay that can appear above the desktop or inside a gaming session.</p></article>
          <article class="feature feature-wide"><span class="feature-index">05</span><div class="feature-icon">◐</div><h3>Nocturne by design.</h3><p>Graphite glass, lavender accents, compact geometry and motion with discipline. Visual depth without uncontrolled neon.</p><div class="palette"><i></i><i></i><i></i><i></i><i></i></div></article>
        </div>
      </section>

      <section class="section philosophy reveal">
        <div class="shell-width philosophy-inner">
          <div class="kanji" aria-hidden="true">静</div>
          <div><span class="section-kicker">02 · THE IDEA</span><h2>Quiet when idle.<br/><em>Present when needed.</em></h2></div>
          <p>Raohane avoids making the desktop the main character. It should disappear into your workflow, then feel instant when you call it.</p>
        </div>
      </section>

      <section class="section shell-width install-section reveal" id="install">
        <div class="install-copy">
          <div class="section-kicker">03 · INSTALL</div>
          <h2>Three commands.<br/><em>Your desktop changes.</em></h2>
          <p>Raohane 1.0.0 targets modern Arch-based Hyprland systems. The guided installer checks dependencies, stages the native runtime and configures the user service.</p>
          <div class="distro-pills" role="group" aria-label="Supported distributions">
            <span>CachyOS</span><span>Arch Linux</span><span>EndeavourOS</span>
          </div>
          <a class="text-link" href={`${base}install/`}>Open the complete install guide →</a>
        </div>
        <div class="terminal-card">
          <div class="terminal-top"><div><i></i><i></i><i></i></div><span>raohane — install</span><button class="copy-button" data-copy-install>Copy</button></div>
          <pre><code>{installCommand}</code></pre>
          <div class="terminal-status"><span>●</span> guided installer · dependencies checked before install</div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <style>
    .sakura-field i {
      left: var(--petal-x);
      width: calc(11px * var(--petal-scale));
      height: calc(16px * var(--petal-scale));
      opacity: var(--petal-opacity);
      animation-duration: var(--petal-duration);
      animation-delay: var(--petal-delay);
      transform-origin: 50% 64%;
    }

    .sakura-field i::after {
      left: 50%;
      right: auto;
      top: -1px;
      width: 4px;
      height: 4px;
      transform: translateX(-50%) rotate(45deg);
      border-radius: 0 0 4px 4px;
    }

    @keyframes petal-fall {
      0% {
        transform: translate3d(0, -5vh, 0) rotate(var(--petal-rotation)) rotateX(0deg);
      }
      46% {
        transform: translate3d(var(--petal-drift-mid), 52vh, 0) rotate(calc(var(--petal-rotation) + 148deg)) rotateX(52deg);
      }
      100% {
        transform: translate3d(var(--petal-drift-end), 104vh, 0) rotate(calc(var(--petal-rotation) + 318deg)) rotateX(8deg);
      }
    }
  </style>

  <script>
    const copyButton = document.querySelector('[data-copy-install]');
    copyButton?.addEventListener('click', async () => {
      const command = `git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\n./install-raohane.sh`;
      try {
        await navigator.clipboard.writeText(command);
        copyButton.textContent = 'Copied';
        window.setTimeout(() => copyButton.textContent = 'Copy', 1400);
      } catch {
        copyButton.textContent = 'Select text';
      }
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('revealed'));
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((item) => observer.observe(item));
    } else {
      document.querySelectorAll('.reveal').forEach((item) => item.classList.add('revealed'));
    }
  </script>
</BaseLayout>