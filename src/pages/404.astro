---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/content.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found — Raohane" description="This page could not be found. Return to Raohane or open the installation guide." noindex>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content" class="content-main shell-width">
      <section class="page-intro">
        <span class="page-badge">404</span>
        <h1>Page not found.<br/><em>Страница не найдена.</em></h1>
        <p>The address may have changed. / Возможно, адрес изменился.</p>
        <div class="hero-actions" style="justify-content:flex-start">
          <a class="button button-primary" href={base}>Raohane · EN</a>
          <a class="button button-ghost" href={`${base}ru/`}>На главную · RU</a>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
