---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/content.css";

const base = import.meta.env.BASE_URL;
const shots = [
  { image: `${base}screenshots/desktop.webp`, eyebrow: "Рабочий стол", title: "Спокойная основа.", description: "Живая Raohane-сессия с workspaces, Context Island, системным статусом и левой командной поверхностью поверх обоев, а не поверх твоего внимания.", tags: ["Bar", "Context Island", "Sidebar", "Workspaces"] },
  { image: `${base}screenshots/control-center.webp`, eyebrow: "Control Center", title: "Управление системой без лишних окон.", description: "Network, Bluetooth, audio, brightness, notifications, media и session actions находятся в одной нативной поверхности. Выбор микрофона и устройств не дублируется по разным sidebar.", tags: ["Quick Controls", "Audio", "Notifications", "Media"] },
  { image: `${base}screenshots/launcher.webp`, eyebrow: "Launcher", title: "Приложения и действия в одном вызове.", description: "Приложения и действия Raohane используют одну search surface — это основа contextual Launcher, расширенного в релизе 1.2.", tags: ["Apps", "Actions", "Quick access", "Search"] },
  { image: `${base}screenshots/settings.webp`, eyebrow: "Настройки", title: "Вся оболочка в одном workspace.", description: "Themes, widgets, Bar & Dock, displays, graphics, Hyprland preferences, Scenes и integrations находятся в одном Settings workspace.", tags: ["Themes", "Scenes", "Hyprland", "Widgets"] }
];
---

<BaseLayout lang="ru" title="Галерея — Raohane" description="Full HD скриншоты Raohane из реальной Hyprland + Quickshell desktop-сессии.">
  <div class="page-shell">
    <SiteHeader active="showcase" lang="ru" />
    <main id="main-content" class="shell-width showcase-editorial">
      <section class="page-intro">
        <span class="page-badge">4 реальных кадра · 1920 × 1080</span>
        <h1>Живая сессия.<br/><em>Не concept renders.</em></h1>
        <p>Это Full HD кадры из реальной Hyprland-сессии Raohane. Любой кадр открывается в оригинальном разрешении; для небольших экранов сайт автоматически использует варианты 800 × 450.</p>
      </section>

      <section class="showcase-gallery-v3" aria-label="Скриншоты Raohane">
        {shots.map((shot, index) => (
          <article class="showcase-piece">
            <div class="showcase-image">
              <a data-gallery href={shot.image} target="_blank" rel="noreferrer" aria-label={`Открыть Full HD кадр ${shot.eyebrow}`}>
                <img width="1920" height="1080" srcset={`${shot.image.replace(".webp", "-800.webp")} 800w, ${shot.image} 1920w`} sizes="(max-width: 880px) calc(100vw - 38px), 820px" src={shot.image} alt={`Raohane — ${shot.eyebrow}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                <small>FULL HD · ОТКРЫТЬ ↗</small>
              </a>
            </div>
            <div class="showcase-copy">
              <span>0{index + 1} · {shot.eyebrow.toUpperCase()}</span>
              <h2>{shot.title}</h2>
              <p>{shot.description}</p>
              <div class="shot-tags">{shot.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
          </article>
        ))}
      </section>
    </main>
    <SiteFooter lang="ru" />
  </div>
</BaseLayout>
