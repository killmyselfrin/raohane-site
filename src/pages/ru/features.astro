---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/content.css";

const features = [
  ["01", "Scenes", "Balanced, Gaming, Focus и Work накладывают обратимую runtime-policy, не перезаписывая базовую конфигурацию оболочки.", "場"],
  ["02", "Launcher 2.0", "Приложения, Scene-команды, shell actions, вычисления и contextual Gaming controls находятся в одной command surface.", "⌕"],
  ["03", "Context Island", "Recording, privacy, media, смена Scene и active-window context приоритизируются в одной небольшой live surface.", "◌"],
  ["04", "Control Center", "NetworkManager, Bluetooth, PipeWire, яркость, notifications и Scene switching используют общее нативное состояние сервисов.", "⌘"],
  ["05", "Media + lyrics", "MPRIS, LRCLIB lyrics, click-to-seek и fullscreen-friendly overlay остаются полезными и на desktop, и в играх.", "♫"],
  ["06", "Capture tools", "Скриншоты, native gameplay recording, OCR и screen translation следуют одному interaction model Raohane.", "◎"],
  ["07", "Desktop system", "Bar, Dock, Overview, wallpaper tools, desktop widgets и Settings используют одну theme, motion и config архитектуру.", "▣"],
  ["08", "Event-driven runtime", "Общие PipeWire, NetworkManager и Bluetooth monitors держат состояние живым, а медленные опросы остаются repair-path.", "↯"]
];
---

<BaseLayout lang="ru" title="Возможности — Raohane" description="Scenes, Launcher, Context Island, нативные системные controls, media, capture tools и общая runtime-архитектура Raohane 1.2.1.">
  <div class="page-shell editorial-page">
    <SiteHeader active="features" lang="ru" />
    <main id="main-content" class="content-main shell-width">
      <section class="page-intro">
        <span class="page-badge">Raohane 1.2.1 · карта системы</span>
        <h1>Не виджеты.<br/><em>Desktop system.</em></h1>
        <p>Поверхности Raohane построены вокруг общего состояния и обратимого контекста. Launcher, Control Center, Context Island, media layer и desktop tools не держат отдельные копии одной и той же системной логики.</p>
      </section>

      <section class="feature-ledger" aria-label="Возможности Raohane">
        {features.map(([index, title, description, mark]) => (
          <article class="feature-ledger-row">
            <span>{index}</span>
            <h2>{title}</h2>
            <p>{description}</p>
            <b aria-hidden="true">{mark}</b>
          </article>
        ))}
      </section>

      <section class="architecture-band">
        <div>
          <span class="section-kicker">НАТИВНАЯ АРХИТЕКТУРА</span>
          <h2>Построено для<br/><em>Hyprland.</em></h2>
        </div>
        <div class="architecture-stack">
          <div><b>Runtime</b><span>Quickshell + Qt/QML surfaces с Raohane-owned state и configuration.</span></div>
          <div><b>Context</b><span>Wayland/Hyprland active-window state управляет app-aware Scene rules без постоянного polling loop.</span></div>
          <div><b>System</b><span>PipeWire, NetworkManager, BlueZ, portals и compositor-facing actions скрыты за общими сервисами.</span></div>
          <div><b>Safety</b><span>Scene changes — временные overlays: после контекста возвращается выбранный baseline пользователя, а не переписанный конфиг.</span></div>
        </div>
      </section>
    </main>
    <SiteFooter lang="ru" />
  </div>
</BaseLayout>
