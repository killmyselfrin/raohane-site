---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ShellPreview from "../../components/ShellPreview.astro";

const base = import.meta.env.BASE_URL;
const prefix = `${base}ru/`;
const installCommand = "git clone https://github.com/killmyselfrin/raohane-dots.git\ncd raohane-dots\nbash install.sh";
---

<BaseLayout lang="ru" title="Raohane — нативная оболочка для Hyprland" description="Raohane — нативная оболочка Hyprland + Quickshell с быстрыми системными поверхностями, единым дизайном и глубокой интеграцией с Linux desktop stack.">
  <div class="page-shell ru-home">
    <SiteHeader active="home" lang="ru" />
    <main id="main-content">
      <section class="ru-hero shell-width">
        <div class="ru-hero-glow"></div>
        <div class="ru-copy">
          <span class="eyebrow"><span></span> HYPRLAND · QUICKSHELL · NATIVE</span>
          <h1>Рабочий стол,<br/><em>собранный воедино.</em></h1>
          <p>Raohane — спокойная и отзывчивая оболочка вокруг Hyprland. Нативные системные элементы, короткие анимации и визуальный язык, который не мешает работе.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={`${prefix}install/`}>Установить Raohane <span>→</span></a>
            <a class="button button-ghost" href={`${prefix}showcase/`}>Реальные скриншоты</a>
          </div>
          <div class="hero-meta">
            <span><b>Hyprland</b> + Quickshell</span>
            <span><b>Arch</b> в приоритете</span>
            <span><b>GPL-3.0</b> open source</span>
          </div>
        </div>

        <ShellPreview lang="ru" />
      </section>

      <section class="ru-section shell-width">
        <span class="section-kicker">01 · ОДНА ОБОЛОЧКА</span>
        <div class="ru-heading">
          <h2>Все поверхности говорят<br/><em>на одном языке.</em></h2>
          <p>Bar, Launcher, Control Center, Settings, Media Overlay и desktop tools используют общие состояния, темы и motion system.</p>
        </div>
        <div class="ru-grid">
          <article><b>⌘</b><h3>Быстрые поверхности</h3><p>Критичные панели показываются сразу, а тяжёлое обновление состояния выполняется после первого кадра.</p></article>
          <article><b>◌</b><h3>Нативный контроль</h3><p>PipeWire, NetworkManager, BlueZ, Hyprland и системные сервисы собраны в единый интерфейс.</p></article>
          <article><b>桜</b><h3>Raohane Nocturne</h3><p>Графитовые glass-поверхности, сдержанный lavender accent и японская минималистичная атмосфера.</p></article>
          <article><b>Ⅱ</b><h3>Медиа и игры</h3><p>MPRIS, lyrics и media overlay, который остаётся полезным даже во fullscreen-сессии.</p></article>
        </div>
      </section>

      <section class="ru-section shell-width real-grid-section">
        <span class="section-kicker">02 · В ЖИВОЙ СИСТЕМЕ</span>
        <div class="ru-heading">
          <h2>Raohane<br/><em>в деталях.</em></h2>
          <p>Скриншоты ниже сняты из настоящей Hyprland-сессии с Raohane.</p>
        </div>
        <div class="real-grid">
          <a href={`${prefix}showcase/`}><img width="1920" height="1080" src={`${base}screenshots/control-center.webp`} alt="Control Center Raohane" loading="lazy" /><span>Control Center</span></a>
          <a href={`${prefix}showcase/`}><img width="1920" height="1080" src={`${base}screenshots/launcher.webp`} alt="Launcher Raohane" loading="lazy" /><span>Launcher</span></a>
          <a href={`${prefix}showcase/`}><img width="1920" height="1080" src={`${base}screenshots/settings.webp`} alt="Settings Raohane" loading="lazy" /><span>Settings</span></a>
        </div>
      </section>

      <section class="ru-section shell-width install-block">
        <div>
          <span class="section-kicker">03 · УСТАНОВКА</span>
          <h2>Три команды.<br/><em>Новый рабочий стол.</em></h2>
          <p>Установщик проверяет зависимости, устанавливает оболочку и настраивает пользовательский сервис Raohane.</p>
          <a class="text-link" href={`${prefix}install/`}>Полная инструкция по установке →</a>
        </div>
        <div class="terminal-card">
          <div class="terminal-top"><div><i></i><i></i><i></i></div><span>raohane — install</span></div>
          <pre><code>{installCommand}</code></pre>
          <div class="terminal-status"><span>●</span> CachyOS · Arch Linux · EndeavourOS</div>
        </div>
      </section>
    </main>
    <SiteFooter lang="ru" />
  </div>
</BaseLayout>

<style>
  .ru-hero { min-height: 900px; padding: 108px 0 80px; position: relative; text-align: center; }
  .ru-hero-glow { position:absolute; width:520px; height:320px; left:50%; top:90px; transform:translateX(-50%); background:rgba(132,104,218,.16); filter:blur(100px); border-radius:50%; pointer-events:none; }
  .ru-copy { width:min(860px,100%); margin:0 auto; position:relative; z-index:2; }
  .ru-copy > p { width:min(680px,100%); margin:0 auto; color:var(--text-soft); font-size:18px; line-height:1.7; }
  .live-shot { width:min(1080px,100%); margin:70px auto 0; position:relative; display:block; overflow:hidden; border-radius:28px; border:1px solid rgba(255,255,255,.12); box-shadow:var(--shadow); background:#090b10; text-align:left; }
  .live-shot img { width:100%; display:block; transition:transform 420ms cubic-bezier(.2,.8,.2,1), filter 220ms ease; }
  .live-shot:hover img { transform:scale(1.01); filter:brightness(1.035); }
  .live-shot-label { position:absolute; left:18px; bottom:18px; display:flex; align-items:center; gap:12px; padding:10px 12px; border:1px solid rgba(255,255,255,.1); border-radius:12px; background:rgba(8,10,15,.76); backdrop-filter:blur(18px); }
  .live-shot-label span { color:var(--accent); font-size:8px; letter-spacing:.15em; font-weight:700; }
  .live-shot-label b { font-size:11px; }
  .live-shot-label em { color:var(--muted); font-size:10px; font-style:normal; }
  .ru-section { padding:100px 0; }
  .ru-heading { display:grid; grid-template-columns:1.1fr .7fr; gap:60px; align-items:end; margin:18px 0 42px; }
  .ru-heading h2, .install-block h2 { margin:0; font-family:Manrope,Inter,sans-serif; font-size:clamp(38px,5vw,64px); line-height:1; letter-spacing:-.05em; }
  .ru-heading p, .install-block p { color:var(--text-soft); line-height:1.75; }
  .ru-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
  .ru-grid article { padding:28px; min-height:190px; border:1px solid var(--line); border-radius:20px; background:rgba(255,255,255,.025); }
  .ru-grid article > b { color:var(--accent); font-size:25px; }
  .ru-grid h3 { margin:30px 0 8px; font-size:17px; }
  .ru-grid p { margin:0; color:var(--muted); line-height:1.65; font-size:13px; }
  .real-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .real-grid a { overflow:hidden; border:1px solid var(--line); border-radius:18px; background:#0b0d12; }
  .real-grid img { width:100%; display:block; aspect-ratio:16/9; object-fit:cover; transition:transform 300ms ease; }
  .real-grid a:hover img { transform:scale(1.018); }
  .real-grid span { display:block; padding:12px 14px; color:var(--text-soft); font-size:11px; font-weight:600; }
  .install-block { display:grid; grid-template-columns:.8fr 1.1fr; gap:60px; align-items:center; }
  .install-block .terminal-card { width:100%; }
  @media(max-width:820px){
    .ru-hero{padding-top:75px;min-height:auto}.ru-heading,.install-block{grid-template-columns:1fr;gap:24px}.ru-grid,.real-grid{grid-template-columns:1fr}.live-shot-label b,.live-shot-label em{display:none}
  }
</style>
