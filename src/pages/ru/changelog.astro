---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/content.css";

const releases = [
  { title: "1.2.1 — Lyrics flow hotfix", status: "Stable · 8 сентября 2026", items: ["Улучшена читаемость plain и synced LRCLIB lyrics в media overlay и lyrics-only режиме.", "Lyric delegates сохраняют стабильную ширину, поэтому активные строки больше не клипуются по краям.", "Lyrics-only использует светлый текст с тёмным outline поверх произвольного fullscreen-контента.", "Первая и последняя timed-строки получают достаточно пространства, чтобы центрироваться так же, как остальные.", "MPRIS, click-to-seek и весь contextual-shell функционал 1.2 сохранены."] },
  { title: "1.2.0 — Contextual shell", status: "Stable · 8 сентября 2026", items: ["Добавлены Balanced, Gaming, Focus и Work Scenes с обратимой runtime-policy без перезаписи базовой конфигурации пользователя.", "Добавлено event-driven переключение Scene по активному приложению с пользовательскими правилами, manual override и возвратом к выбранной Scene после завершения контекста.", "Scene controls появились в Control Center и в отдельном Settings editor для auto switching, app rules и поведения каждой Scene.", "Launcher получил Scene-команды и Gaming quick actions для микрофона, audio output, записи, Game Mode, DND и media.", "Добавлена нативная gameplay recording и расширен Context Island для recording, privacy, Scene и active-app feedback.", "Dock и motion применяются как временные Scene overlays и восстанавливают baseline после выхода из режима."] },
  { title: "1.1.0 — Whole-shell polish", status: "Stable · 8 сентября 2026", items: ["Визуальный polish всей оболочки: Settings, Control Center, Launcher, Wallpaper Selector, Overview, Media Overlay, OSD, Session, DropShelf, Polkit, Left Sidebar, Desktop Menu и Screen Translator.", "Более крупные и читаемые Settings и studio-поверхности без смены registry/router/config архитектуры.", "Runtime-поверхности приведены к более единому масштабу без лишнего rewrite security- и density-sensitive Lock, Context Island, OSK, Task Manager, Bar и Dock.", "Дублирующий выбор аудио- и микрофонных устройств не возвращён в Left Sidebar.", "Точечная оптимизация уменьшает лишний startup overhead и повторные audio refresh на частых путях открытия.", "Stable head проходит release boundary, QML, localization, graphics, backup, singleton-runtime и полный Raohane audit."] },
  { title: "1.0.0 — Первый стабильный релиз", status: "Stable · 8 сентября 2026", items: ["Первая стабильная версия Raohane с самостоятельным Hyprland + Quickshell runtime.", "Нативные Settings, Launcher, Control Center, notifications, wallpaper tools, Task Manager, media surfaces и desktop widgets.", "Собственная библиотека тем Raohane со встроенными пресетами и пользовательским import/export/editing.", "Guided installer для Arch-family, Nix package, NixOS module и Home Manager module.", "Release/runtime/localization/graphics/QML проверки для воспроизводимой stable-упаковки.", "Старый сторонний каталог палитр удалён из product theme path до стабильного релиза."] },
  { title: "0.10.0-dev — Standalone + Minimal Theme System", status: "Этап разработки", items: ["Общий theme engine и shared surface tokens.", "Нативные Settings, Launcher, Control Center, notifications и wallpaper selector.", "Fullscreen-friendly media overlay, Context Island и native OSD.", "Standalone runtime, dependency manifests и release-boundary validation.", "Japanese-minimal направление и несколько палитр."] },
  { title: "0.9.0-dev — Context Foundation", status: "Этап разработки", items: ["Priority-based Context Island для privacy, recording, media и window context.", "Reusable quick tiles и seekable MPRIS card.", "Launcher actions и game-capable media overlay.", "Расширенная конфигурация и audit coverage."] },
  { title: "0.8.0-dev — Visual Foundation", status: "Этап разработки", items: ["Нативные Raohane Bar и Control Center напрямую из shell root.", "Native Launcher и Settings registry.", "Three-pod bar composition с Context Island по центру.", "Raohane-only panel family и удаление legacy primary loaders."] }
];
---

<BaseLayout lang="ru" title="Raohane 1.2.1 — история изменений" description="Release notes стабильной версии Raohane 1.2.1, contextual-shell релиза 1.2.0, whole-shell polish 1.1 и предыдущих этапов разработки.">
  <div class="page-shell">
    <SiteHeader active="changelog" lang="ru" />
    <main id="main-content" class="content-main shell-width">
      <section class="page-intro">
        <span class="page-badge">1.2.1 stable</span>
        <h1>Контекст впереди.<br/><em>Стабильность в основе.</em></h1>
        <p>Raohane 1.2 превращает оболочку в context-aware систему с обратимыми Scenes, app rules, contextual Launcher actions и native recording. Версия 1.2.1 дорабатывает media и lyrics без смены этой основы.</p>
      </section>
      <section class="timeline" aria-label="История версий">
        {releases.map((release) => <article class="release"><div class="release-top"><h2>{release.title}</h2><span class="status">{release.status}</span></div><ul>{release.items.map((item) => <li>{item}</li>)}</ul></article>)}
      </section>
      <section class="section-block">
        <header><span class="section-kicker">Источник истины</span><h2>Все изменения,<br/><em>не только highlights.</em></h2><p>Полный changelog хранится рядом с runtime-кодом, чтобы release notes не расходились с реализацией.</p></header>
        <a class="button button-ghost" href="https://github.com/killmyselfrin/raohane-dots/blob/main/CHANGELOG.md" target="_blank" rel="noreferrer">Открыть полный changelog ↗</a>
      </section>
    </main>
    <SiteFooter lang="ru" />
  </div>
</BaseLayout>
