---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/content.css";

const releases = [
  {
    title: "1.0.0 — First Stable Release",
    status: "Stable · September 8, 2026",
    items: [
      "First stable Raohane release with a standalone Hyprland + Quickshell runtime.",
      "Native Settings, Launcher, Control Center, notifications, wallpaper tools, Task Manager, media surfaces and desktop widgets.",
      "Raohane-owned theme library with built-in presets plus user theme import, export and editing.",
      "Arch-family guided installer, Nix package, NixOS module and Home Manager module.",
      "Release, runtime, localization, graphics and QML boundary validation for reproducible stable packaging.",
      "Retired third-party palette catalog removed from the product theme path before the stable release."
    ]
  },
  {
    title: "0.10.0-dev — Standalone + Minimal Theme System",
    status: "Development milestone",
    items: [
      "Whole-shell Raohane theme engine with shared surface tokens.",
      "Native Settings, Launcher, Control Center, notifications and wallpaper selector.",
      "Fullscreen-friendly media overlay, Context Island and native OSD.",
      "Standalone runtime, dependency manifests and release-boundary validation.",
      "Japanese-minimal visual direction with restrained motion and multiple palettes."
    ]
  },
  {
    title: "0.9.0-dev — Context Foundation",
    status: "Development milestone",
    items: [
      "Priority-based Context Island for privacy, recording, media and window context.",
      "Reusable quick tiles and seekable MPRIS card.",
      "Keyboard launcher actions and native game media overlay.",
      "Expanded Raohane configuration namespace and audit coverage."
    ]
  },
  {
    title: "0.8.0-dev — Visual Foundation",
    status: "Development milestone",
    items: [
      "Native Raohane Bar and Control Center loaded directly from the shell root.",
      "Native Launcher and Settings registry.",
      "Three-pod bar composition with Context Island at the center.",
      "Raohane-only panel family and removal of legacy primary loaders."
    ]
  }
];
---

<BaseLayout title="Raohane 1.0.0 Changelog" description="Release notes for Raohane 1.0.0, the first stable Hyprland + Quickshell desktop shell release, plus earlier development milestones.">
  <div class="page-shell">
    <SiteHeader active="changelog" />
    <main id="main-content" class="content-main shell-width">
      <section class="page-intro">
        <span class="page-badge">1.0.0 stable</span>
        <h1>Stable foundation.<br/><em>Still moving forward.</em></h1>
        <p>Raohane 1.0.0 is the first stable release. This page tracks major product milestones; the source repository keeps the complete line-by-line changelog.</p>
      </section>

      <section class="timeline" aria-label="Release history">
        {releases.map((release) => (
          <article class="release">
            <div class="release-top">
              <h2>{release.title}</h2>
              <span class="status">{release.status}</span>
            </div>
            <ul>{release.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </section>

      <section class="section-block">
        <header>
          <span class="section-kicker">Source of truth</span>
          <h2>Every change, <em>not just highlights.</em></h2>
          <p>The complete changelog stays next to the runtime code so release notes and implementation never drift apart.</p>
        </header>
        <a class="button button-ghost" href="https://github.com/killmyselfrin/raohane-dots/blob/main/CHANGELOG.md" target="_blank" rel="noreferrer">Open full changelog ↗</a>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
