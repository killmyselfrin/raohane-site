---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/content.css";

const features = [
  ["01", "Scenes", "Balanced, Gaming, Focus and Work apply reversible runtime policy without overwriting your base shell configuration.", "場"],
  ["02", "Launcher 2.0", "Applications, Scene commands, shell actions, calculations and contextual Gaming controls live in one command surface.", "⌕"],
  ["03", "Context Island", "Recording, privacy, media, Scene changes and active-window context are prioritized into one small live surface.", "◌"],
  ["04", "Control Center", "NetworkManager, Bluetooth, PipeWire, brightness, notifications and Scene switching share native service state.", "⌘"],
  ["05", "Media + lyrics", "MPRIS playback, LRCLIB lyrics, click-to-seek and a fullscreen-friendly overlay stay usable across desktop and games.", "♫"],
  ["06", "Capture tools", "Screenshots, native gameplay recording, OCR and screen translation follow the same Raohane interaction model.", "◎"],
  ["07", "Desktop system", "Bar, Dock, Overview, wallpaper tools, desktop widgets and Settings use one theme, motion and configuration architecture.", "▣"],
  ["08", "Event-driven runtime", "Shared PipeWire, NetworkManager and Bluetooth monitors keep state live while slower polling remains a repair path.", "↯"]
];
---

<BaseLayout title="Features — Raohane" description="Explore Scenes, Launcher, Context Island, native system controls, media, capture tools and the shared runtime architecture in Raohane 1.2.1.">
  <div class="page-shell editorial-page">
    <SiteHeader active="features" />
    <main id="main-content" class="content-main shell-width">
      <section class="page-intro">
        <span class="page-badge">Raohane 1.2.1 · system map</span>
        <h1>Not widgets.<br/><em>A desktop system.</em></h1>
        <p>Raohane surfaces are designed around shared state and reversible context. The Launcher, Control Center, Context Island, media layer and desktop tools do not need separate copies of the same system logic.</p>
      </section>

      <section class="feature-ledger" aria-label="Raohane features">
        {features.map(([index, title, description, mark]) => (
          <article class="feature-ledger-row">
            <span>{index}</span>
            <h2>{title}</h2>
            <p>{description}</p>
            <b aria-hidden="true">{mark}</b>
          </article>
        ))}
      </section>

      <section class="architecture-band">
        <div>
          <span class="section-kicker">NATIVE ARCHITECTURE</span>
          <h2>Built for<br/><em>Hyprland.</em></h2>
        </div>
        <div class="architecture-stack">
          <div><b>Runtime</b><span>Quickshell + Qt/QML surfaces with Raohane-owned state and configuration.</span></div>
          <div><b>Context</b><span>Wayland/Hyprland active-window state drives application-aware Scene rules without a permanent polling loop.</span></div>
          <div><b>System</b><span>PipeWire, NetworkManager, BlueZ, portals and compositor-facing actions stay behind shared services.</span></div>
          <div><b>Safety</b><span>Scene changes are temporary overlays: leaving a context restores the user's selected baseline instead of rewriting it.</span></div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
